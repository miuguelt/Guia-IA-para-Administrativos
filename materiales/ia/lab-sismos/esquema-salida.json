{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resultado generado · Explora los sismos del catálogo",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "fields",
    "tool"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "artifactId": {
      "const": "LAB-A01"
    },
    "fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pregunta",
        "fuente",
        "procedimiento",
        "verificacion",
        "conclusion"
      ],
      "properties": {
        "pregunta": {
          "type": "string",
          "minLength": 1
        },
        "fuente": {
          "type": "string",
          "minLength": 1
        },
        "procedimiento": {
          "type": "string",
          "minLength": 1
        },
        "verificacion": {
          "type": "string",
          "minLength": 1
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tool": {
      "type": "string",
      "minLength": 1
    }
  }
}
